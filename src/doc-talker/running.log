          },
          [
            [
              "text",
              {
                "namespace": "urn:ietf:params:xml:ns:yang:yin:1"
              },
              [
                "The node cannot be modified, when node is already configured."
              ]
            ]
          ]
        ]
      ]
    ]
  ]
]
